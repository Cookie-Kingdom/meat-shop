{"nodes": [{"id": "supabase_migrations_20260908000002_identity_config_profiles", "label": "profiles (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Application identity keyed 1:1 to auth.users, carrying the role that RLS decides on. Cascade delete keeps it in step with the auth row."}, {"id": "supabase_migrations_20260908000002_identity_config_locations", "label": "locations (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One table for CENTRAL, CHEF_HOUSE and BRANCH so every ledger row can name where stock sits."}, {"id": "supabase_migrations_20260908000002_identity_config_locations_rice_model_branch_only", "label": "locations_rice_model_branch_only (check constraint)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rice model only means anything for a branch; central and chef house must leave it null."}, {"id": "supabase_migrations_20260908000002_identity_config_user_locations", "label": "user_locations (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BR12/BR17 delegation: can_receive_central grants the ACT of receiving, not visibility of the data behind it."}, {"id": "supabase_migrations_20260908000002_identity_config_smoke_fee_tiers", "label": "smoke_fee_tiers (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dated weight bands for the smoke fee (ADR-006/ADR-018): the rate is resolved by event date, never a constant in code."}, {"id": "supabase_migrations_20260908000002_identity_config_smoke_fee_tiers_band", "label": "smoke_fee_tiers_band (check constraint)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A band must be non-degenerate: max weight is either null (open-ended top band) or strictly above the minimum."}, {"id": "supabase_migrations_20260908000002_identity_config_config_settings", "label": "config_settings (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-006: every business number lives here, dated and optionally scoped to a location; resolution is (key, scope, effective_from <= event_date) desc limit 1."}, {"id": "supabase_migrations_20260908000002_identity_config_config_settings_one_value", "label": "config_settings_one_value (check constraint)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one of value_numeric / value_text / value_json is set, so a config row has one unambiguous reading."}, {"id": "supabase_migrations_20260908000002_identity_config_config_settings_key_scope_date", "label": "config_settings_key_scope_date (unique index)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coalesces a null scope to a sentinel uuid so global and per-location rows share one unique key per effective date; this natural key also carries config-write idempotency without a key column."}, {"id": "supabase_migrations_20260908000002_identity_config_unlock_requests", "label": "unlock_requests (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R28/ADR-013 reopen path: a closed report or lot is reopened only through a requested, decided and expiring approval, never silently."}, {"id": "supabase_migrations_20260908000002_identity_config_audit_log", "label": "audit_log (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generic before/after trail carrying actor, role, event_date and idempotency_key so a disputed back-dated write can be reconciled."}, {"id": "supabase_migrations_20260908000002_identity_config_notifications", "label": "notifications (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lot_id is declared here without its FK because lots does not exist yet in the chain; the constraint is added in migration ...0003."}], "edges": [{"source": "supabase_migrations_20260908000002_identity_config_profiles", "target": "supabase_migrations_20260908000001_enums_user_role", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/20260908000002_identity_config.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_migrations_20260908000002_identity_config_locations", "target": "supabase_migrations_20260908000001_enums_l