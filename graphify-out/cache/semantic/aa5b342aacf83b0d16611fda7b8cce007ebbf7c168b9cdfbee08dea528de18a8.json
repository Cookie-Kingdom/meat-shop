{"nodes": [{"id": "supabase_policies_config_settings_config_settings_deny_all", "label": "config_settings RLS posture (deny-all, FINAL)", "file_type": "code", "source_file": "supabase/policies/config_settings.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FINAL deny-all (card ^ref-12). NO SELECT POLICY LANDS: reads arrive only through v_config_history, which is SECURITY DEFINER and carries `where fn_current_role() = 'L1_OWNER'` (R34, R20). A table policy would be a second read path around that WHERE, reachable by any session that types the table name into PostgREST \u2014 it would leak dated business numbers (prices, rates, targets) to L2 and L3. Standing consequence: never `force row level security` on this table or on profiles, or the owner-run view returns nothing even for L1."}, {"id": "concept_deny_all_rls_posture", "label": "Deny-all RLS posture (one door: SECURITY DEFINER view in, fn_* out)", "file_type": "concept", "source_file": "supabase/policies/config_settings.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_three_role_boundary", "label": "Three-role boundary (L1 Owner / L2 Branch Admin / L3 CM Operator) enforced in the database", "file_type": "concept", "source_file": "supabase/policies/config_settings.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "supabase_policies_config_settings_config_settings_deny_all", "target": "supabase_migrations_20260908000002_identity_config_config_settings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/config_settings.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_policies_config_settings_config_settings_deny_all", "target": "concept_deny_all_rls_posture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/config_settings.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_policies_config_settings_config_settings_deny_all", "target": "supabase_functions_fn_current_role_fn_current_role", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/config_settings.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_policies_config_settings_config_settings_deny_all", "target": "concept_no_second_read_path", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/config_settings.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_policies_config_settings_config_settings_deny_all", "target": "concept_three_role_boundary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/config_settings.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_functions_fn_current_role_fn_current_role", "target": "concept_three_role_boundary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/config_settings.sql", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "final_deny_all_one_door_through_definer_view", "label": "FINAL deny-all: the SECURITY DEFINER view is the only read door (no table policy ever lands)", "nodes": ["supabase_policies_config_settings_config_settings_deny_all", "supabase_policies_packaging_full_stock_packaging_full_stock_deny_all", "supabase_policies_product_prices_product_prices_deny_all", "supabase_policies_audit_log_audit_log_deny_all", "concept_no_second_read_path", "supabase_functions_fn_current_role_fn_current_role"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/config_settings.sql"}]}