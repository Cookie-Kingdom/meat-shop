{"nodes": [{"id": "agents_nextjs_agent_rules", "label": "Next.js Agent Rules Block", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "lines 1-9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This Next.js version has breaking changes from model training data, so agents must read node_modules/next/dist/docs/ before writing framework code. The block is machine-generated and re-added by `next dev`, so deleting it from a diff only recreates an uncommitted change - committing it with the work keeps the tree clean."}, {"id": "agents_generate_agent_files", "label": "generate-agent-files.js (Next.js AGENTS.md generator)", "file_type": "code", "source_file": "AGENTS.md", "source_location": "line 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_next_dist_docs", "label": "node_modules/next/dist/docs (authoritative Next.js guides)", "file_type": "document", "source_file": "AGENTS.md", "source_location": "line 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolved from AGENTS.md's own directory rather than the repo root, because in monorepos the `next` package may not be visible from the root."}, {"id": "agents_git_workflow", "label": "Git Workflow", "file_type": "document", "source_file": "AGENTS.md", "source_location": "lines 13-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented in AGENTS.md rather than CLAUDE.md because CLAUDE.md is gitignored and AGENTS.md is checked in, so the workflow travels with the repo."}, {"id": "agents_develop_branch", "label": "develop (integration branch)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "lines 15-16, 21, 24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work starts from an up-to-date develop and finished work merges back into it with --no-ff, so each card stays visible as a merge commit. Card work is never committed directly to develop."}, {"id": "agents_main_branch", "label": "main (release-only branch)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "lines 16, 29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved for releases; direct commits are forbidden so the release line only ever moves through an integration merge."}, {"id": "agents_feature_branch_convention", "label": "feature/<short-slug> branch naming convention", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "lines 22, 27-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "English kebab-case named after the Tasks.md card, not after the files touched, so the branch name maps to board work rather than to implementation detail. fix/<slug> covers defects that are not cards."}, {"id": "agents_one_card_one_branch_one_merge", "label": "One card = one branch = one merge", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "lines 18, 29-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps each unit of merged history traceable to exactly one board card. Branch first even for one-line changes; a second piece of work discovered mid-card becomes a new card on the board rather than an extra commit on the current branch."}, {"id": "agents_merge_gate", "label": "Merge gate: acceptance line true, pnpm build and pnpm lint pass", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "lines 31-32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A branch that does not build does not merge, so develop is always in a buildable state and the card's own Acceptance: line is the functional bar."}, {"id": "agents_tasks_md", "label": "Tasks.md (implementation Kanban board)", "file_type": "document", "source_file": "AGENTS.md", "source_location": "lines 18, 31", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_nextjs_agent_rules", "target": "agents_generate_agent_files", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "line 7", "weight": 1.0}, {"source": "agents_generate_agent_files", "target": "agents_nextjs_agent_rules", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "line 7", "weight": 1.0}, {"source": "agents_nextjs_agent_rules", "target": "agents_next_dist_docs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "line 5", "weight": 1.0}, {"source": "agents_git_workflow", "target": "agents_develop_branch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "lines 15-16", "weight": 1.0}, {"source": "agents_git_workflow", "target": "agents_main_branch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "line 16", "weight": 1.0}, {"source": "agents_git_workflow", "target": "agents_feature_branch_convention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "lines 22, 27", "weight": 1.0}, {"source": "agents_git_workflow", "target": "agents_one_card_one_branch_one_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "line 18", "weight": 1.0}, {"source": "agents_one_card_one_branch_one_merge", "target": "agents_tasks_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "line 18", "weight": 1.0}