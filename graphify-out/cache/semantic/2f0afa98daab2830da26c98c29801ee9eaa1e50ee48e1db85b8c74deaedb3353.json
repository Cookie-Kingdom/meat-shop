{"nodes": [{"id": "supabase_migrations_20260908000009_daily_report_clocks_daily_reports_one_open", "label": "daily_reports_one_open (unique partial index)", "file_type": "code", "source_file": "supabase/migrations/20260908000009_daily_report_clocks.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "THE implementation of ADR-014: exactly one OPEN report per branch is what makes a 01:00 entry land on the previous day \u2014 the open row is the business-day boundary, not a clock. The predicate must be status = 'OPEN', never status <> 'CLOSED', so an UNLOCKED past day (R28/ADR-013) can coexist with today."}], "edges": [{"source": "supabase_migrations_20260908000009_daily_report_clocks_daily_reports_one_open", "target": "supabase_migrations_20260908000004_stock_and_branch_daily_daily_reports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/20260908000009_daily_report_clocks.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_migrations_20260908000009_daily_report_clocks_daily_reports_one_open", "target": "supabase_migrations_20260908000001_enums_report_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/20260908000009_daily_report_clocks.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_migrations_20260908000009_daily_report_clocks_daily_reports_one_open", "target": "supabase_migrations_20260908000002_identity_config_audit_log", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "supabase/migrations/20260908000009_daily_report_clocks.sql", "source_location": null, "weight": 1.0}], "hyperedges": []}