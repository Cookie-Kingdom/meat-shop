{"nodes": [{"id": "supabase_policies_unlock_requests_unlock_requests_rls_posture", "label": "unlock_requests RLS posture (deny-all)", "file_type": "code", "source_file": "supabase/policies/unlock_requests.sql", "source_location": "lines 11-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS enabled with no policy and a full revoke from anon and authenticated - deny-all. An unlock request is the L2/L3 escalation path to an L1 Owner approval, so both the raise and the approve are SECURITY DEFINER fn_* calls rather than table grants; the role check lives in the function and the view, not in the UI (ADR-002, ADR-004)."}], "edges": [{"source": "supabase_policies_unlock_requests_unlock_requests_rls_posture", "target": "supabase_migrations_20260908000002_identity_config_unlock_requests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/unlock_requests.sql", "source_location": "alter table public.unlock_requests enable row level security", "weight": 1.0}, {"source": "supabase_policies_unlock_requests_unlock_requests_rls_posture", "target": "supabase_policies_products_deny_all_until_view_posture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/unlock_requests.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_policies_unlock_requests_unlock_requests_rls_posture", "target": "supabase_policies_profiles_three_role_boundary", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "supabase/policies/unlock_requests.sql", "source_location": null, "weight": 1.0}], "hyperedges": []}