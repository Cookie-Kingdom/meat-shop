{"nodes": [{"id": "supabase_migrations_20260908000008_po_idempotency_purchase_orders_idempotency_key", "label": "purchase_orders_idempotency_key (unique index + column)", "file_type": "code", "source_file": "supabase/migrations/20260908000008_po_idempotency.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R4/ADR-005 needs a client-generated retry key and po_number cannot serve: it is minted inside fn_create_po, so a replay mints a second number and a second PO and the existing unique index never fires. Nullable because the writer rejects a null key before writing."}, {"id": "supabase_migrations_20260908000008_po_idempotency_po_deliveries_idempotency_key", "label": "po_deliveries_idempotency_key (unique index + column)", "file_type": "code", "source_file": "supabase/migrations/20260908000008_po_idempotency.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(po_id, seq) cannot carry the retry because seq is derived as max(seq)+1, so a replay books a second round and every lot, freight share and yield figure downstream inherits it. A payload key on (po_id, event_date, weight) is worse: two genuine same-day rounds are ordinary and would be refused (TC-24)."}], "edges": [{"source": "supabase_migrations_20260908000008_po_idempotency_purchase_orders_idempotency_key", "target": "supabase_migrations_20260908000003_purchasing_production_purchase_orders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/20260908000008_po_idempotency.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_migrations_20260908000008_po_idempotency_po_deliveries_idempotency_key", "target": "supabase_migrations_20260908000003_purchasing_production_po_deliveries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/2026