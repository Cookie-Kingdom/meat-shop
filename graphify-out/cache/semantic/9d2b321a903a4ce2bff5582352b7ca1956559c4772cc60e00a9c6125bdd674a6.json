{"nodes": [{"id": "supabase_migrations_20260908000003_purchasing_production_suppliers", "label": "suppliers (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000003_purchasing_production_purchase_orders", "label": "purchase_orders (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Head of the purchasing chain; po_number is unique but generated inside fn_create_po, which is why it cannot serve as a retry key (see ...0008)."}, {"id": "supabase_migrations_20260908000003_purchasing_production_po_deliveries", "label": "po_deliveries (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "foodiva_sent_weight_kg here is THE loss base and the smoke-fee tier base (BR03/BR10, ADR-011) \u2014 never the Chiang Mai received weight."}, {"id": "supabase_migrations_20260908000003_purchasing_production_lots", "label": "lots (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D01: one delivery round, one lot \u2014 po_delivery_id is UNIQUE. return_pickup_date gates the return run (BR17): closing a lot creates no transport job on its own."}, {"id": "supabase_migrations_20260908000003_purchasing_production_notifications_lot_id_fkey", "label": "notifications_lot_id_fkey (foreign key)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred FK: notifications was created before lots existed, so the constraint is attached here once the target table is in place."}, {"id": "supabase_migrations_20260908000003_purchasing_production_lot_receipts", "label": "lot_receipts (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R16a: received_weight_kg is a CROSS-CHECK only and never the loss base; the divisor stays the Foodiva dispatch weight (ADR-011)."}, {"id": "supabase_migrations_20260908000003_purchasing_production_smoke_daily_logs", "label": "smoke_daily_logs (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R6: one log per lot per day. input_weight_kg is a trigger-maintained roll-up of its sources (R6a), never typed directly."}, {"id": "supabase_migrations_20260908000003_purchasing_production_smoke_daily_log_sources", "label": "smoke_daily_log_sources (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D05: one smoking day may draw input from several lots, so each contributing lot gets its own row and the parent sums them."}, {"id": "supabase_migrations_20260908000003_purchasing_production_fn_rollup_smoke_log_input", "label": "fn_rollup_smoke_log_input() (trigger function)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R6a: keeps the parent input weight equal to the sum of its source rows so the two can never disagree."}, {"id": "supabase_migrations_20260908000003_purchasing_production_trg_rollup_smoke_log_input", "label": "trg_rollup_smoke_log_input (trigger)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000003_purchasing_production_smoke_date_groups", "label": "smoke_date_groups (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R7: the FIFO unit \u2014 one group per lot per smoke date, so a branch quantity traces back to a smoke-date group and then to a lot."}, {"id": "supabase_migrations_20260908000003_purchasing_production_lot_bags", "label": "lot_bags (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000003_purchasing_production_transport_runs", "label": "transport_runs (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "alloc_method is snapshotted on the run (BR16) so a later config change cannot retroactively re-split freight already booked."}, {"id": "supabase_migrations_20260908000003_purchasing_production_transport_runs_branch_leg_free", "label": "transport_runs_branch_leg_free (check constraint)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R25/BR11: a CENTRAL_TO_BRANCH run carries no fare, so run_cost_thb must be zero on that route."}, {"id": "supabase_migrations_20260908000003_purchasing_production_transport_lines", "label": "transport_lines (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D06 outstanding_weight_kg and BR12 variance_pct are generated columns; variance_pct is a sort key only, because the threshold verdict belongs to fn_check_variance (ADR-019), which rounds before comparing."}], "edges": [{"source": "supabase_migrations_20260908000003_purchasing_production_purchase_orders", "target": "supabase_migrations_20260908000003_purchasing_production_suppliers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_migrations_20260908000003_purchasing_production_purchase_orders", "target": "supabase_migrations_20260908000002_identity_config_profiles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_migrations_20260908000003_purchasing_production_po_deliveries", "target": "supabase_migrations_20260908000003_purchasing_production_purchase_orders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/migrations/20260908000003_purchasing_production.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_migrations_20260908000003_purchasing_production_lots", "target": "supabase_migrations_20260908000003_purchasing_production_purchase