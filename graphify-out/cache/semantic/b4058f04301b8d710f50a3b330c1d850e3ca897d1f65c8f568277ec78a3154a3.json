{"nodes": [{"id": "supabase_migrations_20260908000004_stock_and_branch_daily_products", "label": "products (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "is_stock_tracked is false for items like drinks that are sold but never enter the ledger."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_product_prices", "label": "product_prices (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BR23: prices are dated rows, unique per (product, effective_from); cost_thb is null where the cost comes from the lot instead."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_packaging_items", "label": "packaging_items (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_packaging_full_stock", "label": "packaging_full_stock (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R9: full_stock_qty must be strictly positive because zero would mean 'not configured' and is used as a divisor for the low-material alert."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_daily_reports", "label": "daily_reports (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BR22/ADR-014: report_date is the BUSINESS date. A 01:00 entry attaches to the branch's still-open report and so belongs to the previous day; R5 makes (location, date) unique."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_sales_lines", "label": "sales_lines (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "unit_price_thb is a BR23 snapshot taken at sale time; lot_id is nullable in DDL but forced non-null for SMOKED_MEAT by a trigger (R21)."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_thaw_records", "label": "thaw_records (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R15: fifo_override_reason records why the operator skipped the oldest smoke-date group."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_waste_records", "label": "waste_records (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_fn_require_lot_for_meat", "label": "fn_require_lot_for_meat() (trigger function)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R21/D01: every meat movement must name its source lot. Shared by sales_lines and waste_records; it resolves item_type from products for sales and from the row itself for waste."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_trg_sales_lines_lot", "label": "trg_sales_lines_lot (trigger)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_trg_waste_records_lot", "label": "trg_waste_records_lot (trigger)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_physical_counts", "label": "physical_counts (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "system_qty is snapshotted at count time and variance_qty is generated from it, so the count's verdict cannot drift as later ledger rows land."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_rice_records", "label": "rice_records (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two rice models in one table (M7A external-cooked, M7B self-cook); the price columns are L1-only under BR15."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_branch_expenses", "label": "branch_expenses (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_influencer_shipments", "label": "influencer_shipments (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_stock_ledger", "label": "stock_ledger (table)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-003: the only stock table. Append-only, signed qty_delta, no balance column anywhere \u2014 balance is SUM(qty_delta). Carries all three clocks (business_date, event_at, created_at, ADR-007), a unique idempotency_key (R4/ADR-005) and reversal_of for R2 corrections."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_fn_stock_ledger_append_only", "label": "fn_stock_ledger_append_only() (trigger function)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R1: raises unconditionally. It never inspects a row, which is why it is attached as a statement-level trigger."}, {"id": "supabase_migrations_20260908000004_stock_and_branch_daily_trg_stock_ledger_append_only", "label": "trg_stock_ledger_append_only (trigger)", "file_type": "code", "source_file": "supabase/migrations/20260908000004_stock_and_branch_daily.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refuses every UPDATE and DELETE on stock_ledger; corrections must be a REVERSAL row plus a replacement (R1/R2)."}], "edges": [{"source": "supabase_migrations_20260908000004_stock_and_branch_daily_products", "target": "supabase_migrations_20260908000001_enums_item_type", "relation": "references", "