{"nodes": [{"id": "supabase_functions_fn_current_locations_fn_current_locations", "label": "fn_current_locations", "file_type": "code", "source_file": "supabase/functions/fn_current_locations.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the locations the caller may touch as a uuid[]. SECURITY DEFINER for fn_current_role()'s reason: a policy on user_locations must be able to call it without re-entering itself. Returns '{}' and never null \u2014 `x = any(null)` is null, which a policy happens to read as false, and an empty array makes that the right answer by construction rather than by luck. Folds in profiles.is_active (R31), so a deactivated profile touches nothing. can_receive_central is deliberately NOT read here (R27, BR12, BR17): that delegation grants the act of receiving, not extra read scope, and whichever fn_* implements the act checks the column itself."}], "edges": [{"source": "supabase_functions_fn_current_locations_fn_current_locations", "target": "supabase_migrations_20260908000002_identity_config_user_locations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/functions/fn_current_locations.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_functions_fn_current_locations_fn_current_locations", "target": "supabase_migrations_20260908000002_identity_config_profiles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/functions/fn_current_locations.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_functions_fn_current_locations_fn_current_locations", "target": "supabase_functions_fn_current_role_fn_current_role", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/functions/fn_current_locations.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_functio