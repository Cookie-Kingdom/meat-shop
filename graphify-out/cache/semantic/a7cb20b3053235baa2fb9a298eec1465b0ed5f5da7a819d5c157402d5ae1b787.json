{"nodes": [{"id": "supabase_policies_smoke_fee_tiers_l3_price_yield_restriction", "label": "L3 must never read a price or yield column (R20)", "file_type": "concept", "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "label": "smoke_fee_tiers RLS posture (final deny-all, no policy ever)", "file_type": "code", "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": "lines 18-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final, not a placeholder (card ^ref-12): NO SELECT POLICY EVER LANDS. Reads arrive only through v_config_history, which is SECURITY DEFINER and carries `where fn_current_role() = 'L1_OWNER'` (R34, R20) - a policy on the table would be a second read path around that WHERE, reachable by any session that types the table name into PostgREST. Fee tiers are price data, so the single door is what keeps an L2 or L3 session out. Standing consequence: never `force row level security` on this table or on profiles, because the view runs as the owner and forcing RLS would make it return nothing, for L1 too. Writes only via a SECURITY DEFINER fn_set_* (ADR-002, ADR-004)."}, {"id": "supabase_policies_smoke_fee_tiers_v_config_history", "label": "View v_config_history", "file_type": "code", "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "target": "supabase_migrations_20260908000002_identity_config_smoke_fee_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": "alter table public.smoke_fee_tiers enable row level security", "weight": 1.0}, {"source": "supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "target": "supabase_policies_smoke_fee_tiers_v_config_history", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": "\"Reads arrive through v_config_history\"", "weight": 1.0}, {"source": "supabase_policies_smoke_fee_tiers_v_config_history", "target": "supabase_functions_fn_current_role_fn_current_role", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": "\"the view is SECURITY DEFINER and carries `where fn_current_role() = 'L1_OWNER'` (R34, R20)\"", "weight": 1.0}, {"source": "supabase_policies_smoke_fee_tiers_v_config_history", "target": "supabase_migrations_20260908000002_identity_config_smoke_fee_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": null, "weight": 1.0}, {"source": "supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "target": "supabase_policies_smoke_fee_tiers_l3_price_yield_restriction", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": "\"a policy here would be a second read path around that WHERE\" (R34, R20)", "weight": 1.0}, {"source": "supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "target": "supabase_policies_profiles_three_role_boundary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": "fn_current_role() = 'L1_OWNER'", "weight": 1.0}, {"source": "supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "target": "supabase_policies_profiles_profiles_rls_posture", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "supabase/policies/smoke_fee_tiers.sql", "source_location": "\"never `force row level security` on this table or on profiles\"", "weight": 1.0}], "hyperedges": [{"id": "l1_owner_single_read_door", "label": "The L1 Owner single-read-door pattern: SECURITY DEFINER view gated on fn_current_role(), never a second table policy, and never force RLS", "nodes": ["supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "supabase_policies_smoke_fee_tiers_v_config_history", "supabase_functions_fn_current_role_fn_current_role", "supabase_policies_profiles_profiles_select_self_or_owner", "supabase_policies_profiles_three_role_boundary"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/policies/smoke_fee_tiers.sql"}, {"id": "price_and_yield_columns_closed_to_l3", "label": "Tables whose closed posture is what keeps price and yield columns away from an L3 session (R20)", "nodes": ["supabase_policies_smoke_fee_tiers_smoke_fee_tiers_rls_posture", "supabase_policies_purchase_orders_purchase_orders_rls_posture", "supabase_policies_sales_lines_sales_lines_rls_posture", "supabase_policies_smoke_daily_logs_smoke_daily_logs_rls_posture", "supabase_policies_transport_lines_transport_lines_rls_posture", "supabase_policies_staff_staff_rls_posture", "supabase_policies_smoke_fee_tiers_l3_price_yield_restriction"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "supabase/policies/smoke_fee_tiers.sql"}]}